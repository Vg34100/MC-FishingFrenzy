{
  "schemaVersion": 1,
  "id": "fishingfrenzy",
  "version": "${version}",
  "name": "Fishing Frenzy",
  "description": "A fishing expansion mod adding a wide variety of new fish, baits, and fishing mechanics.",
  "authors": [
    "Vg34100"
  ],
  "contact": {
    "homepage": "https://github.com/Vg34100"
  },
  "license": "CC0-1.0",
  "icon": "assets/fishingfrenzy/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.vg.fishingfrenzy.fabric.FishingFrenzyFabric"
    ],
    "client": [
      "net.vg.fishingfrenzy.fabric.client.FishingFrenzyFabricClient"
    ],
    "modmenu": [
      "net.vg.fishingfrenzy.fabric.client.FishingFrenzyModMenu"
    ],
    "fabric-datagen": [
      "net.vg.fishingfrenzy.fabric.data.ModDataGenerator"
    ]
  },
  "mixins": [
    "fishingfrenzy.mixins.json",
    "fishingfrenzy-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "architectury": ">=${architectury_api_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
